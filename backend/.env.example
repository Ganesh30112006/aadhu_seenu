# Copy to backend/.env (never commit the real file).
ENVIRONMENT=development

# PostgreSQL 16 with pgvector (+ pg_trgm from postgresql-contrib).
DATABASE_URL=postgresql+asyncpg://smartclass:change-me@127.0.0.1:5432/smartclass
REDIS_URL=redis://127.0.0.1:6379/0

# Audio chunk storage: local directory, or S3 when S3_BUCKET is set (EC2 instance role grants access).
AUDIO_DIR=data/audio
S3_BUCKET=
AWS_REGION=ap-south-1

# Cookies: keep true in production (HTTPS via Caddy); false only for plain-http local development.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Device defaults sent in `config`.
DEVICE_GAIN=4.0
DEVICE_VAD_ENABLED=true

# ASR (faster-whisper). Choose from the eval/ benchmark; CPU int8 is the baseline.
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LIVE_INTERVAL_S=1.5
ASR_LANGUAGE_MODE=fixed

# Amazon Bedrock (D9). Set the LLM to a model/inference profile enabled in your account
# (Bedrock console → Model access). Embeddings default to Cohere multilingual (Hindi/Telugu).
BEDROCK_LLM_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=cohere.embed-multilingual-v3
LIVE_KEY_TERMS_INTERVAL_S=180
