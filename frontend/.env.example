# Base URL of the FastAPI REST API, as seen by the browser.
# Default "/api" relies on the same-domain reverse proxy (and the Vite dev proxy below).
VITE_API_BASE_URL=/api

# Base URL for WebSockets. Leave empty to derive it from the page origin
# (ws:// on http, wss:// on https), which is right for a same-domain deployment.
VITE_WS_BASE_URL=

# Dev server only (not exposed to the browser): where `npm run dev` proxies /api and /ws.
API_PROXY_TARGET=http://localhost:8000
